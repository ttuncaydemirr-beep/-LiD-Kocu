<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Satın alma (Play Billing), reklam (AdMob) ve kaynak bağlantısı için ağ. BILLING izni Billing Library'den birleşir. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reklam kimliği (AdMob, Firebase Analytics). Play Console > Uygulama içeriği > Reklam kimliği: "Evet". -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Dokunmatik ekran şart değil (Chromebook/TV uyumu için zorunlu değil olarak işaretli) -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="LiD Koçu"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <!-- Android 16 (API 36) büyük ekranlarda (sw >= 600dp) yön kilidini yok sayar; geçici muafiyet. -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Consent Mode v2: Analytics varsayılan olarak rızasız (denied). UMP sonucundan sonra
             lib/services/reklam.dart > olcum.rizaUygula ile FirebaseAnalytics.setConsent uygulanır. -->
        <meta-data android:name="google_analytics_default_allow_analytics_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_user_data" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <!-- AdMob uygulama kimliği: app/build.gradle.kts > manifestPlaceholders (kaynak: lib/services/reklam_ayar.dart).
             Kullanıcı AdMob kimliğini verince reklam_ayar.dart'ta değiştir; boşken Google test kimliği kalır. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobUygulamaKimligi}" />
        <!-- Don't delete the meta-data below. This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Android 11+ paket görünürlüğü: e-posta ve tarayıcı uygulamalarını açabilmek için (url_launcher) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
